{
  "name": "penpot_sync",
  "version": "0.1.0",
  "description": "Penpot Sync \u2014 Nextcloud frontend (Files row icon + Open in Penpot action)",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "comment": "No src/ yet \u2014 the JS frontend (Files row action + Open in Penpot) lands with the file-type slice, mirroring nextcloud-grafana's src/files.js. The @nextcloud/* runtime deps are declared ahead of it so the lockfile and CI cache are stable.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "dependencies": {
    "@nextcloud/event-bus": "^3.3.0",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.2.0",
    "@nextcloud/router": "^3.0.1"
  }
}
