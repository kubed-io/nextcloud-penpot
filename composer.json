{
    "name": "kubed-io/penpot_sync",
    "description": "Penpot Sync \u2014 mirror Penpot design files into Nextcloud as native, read-only files",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.5",
        "nextcloud/coding-standard": "^1.4",
        "nextcloud/ocp": "^33.0",
        "phpunit/phpunit": "^12.0",
        "symfony/console": "^6.0 || ^7.0",
        "vimeo/psalm": "^6.0"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "autoload": {
        "psr-4": {
            "OCA\\PenpotSync\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\PenpotSync\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "scripts": {
        "test:unit": "phpunit --configuration tests/phpunit.unit.xml",
        "lint": "find lib -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "psalm --no-cache"
    }
}
