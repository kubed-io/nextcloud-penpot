<!--
	MEASURED, NOT ASSUMED. Turned on once on #50 to see what it would say: 100
	errors, and about 85 of them unavoidable. Psalm analyses `lib` only and
	cannot see how a Nextcloud app is entered — so every `__construct` is
	"never called" (the DI container calls them), every Command and Controller
	is an "unused class" (info.xml and routes.php name them), every Sabre
	handler has unused params and an unused return (the plugin interface fixes
	both), and every value object read only by a unit test looks dead because
	`tests` is not in projectFiles.

	The real yield was ONE defect — an unused `$mapping` capture in
	MappingTeardownService — which is not worth 85 false positives on every
	run. TURNING IT ON FOR REAL means marking the ~25 framework entry points
	`@psalm-api` and suppressing UnusedParam / PossiblyUnusedReturnValue for
	lib/DAV. That is worth doing and is its own change, not a flag flip.

	The gap it leaves is covered elsewhere: tests/integration/bin/check-step-definitions.sh
	finds dead step definitions, which is where the dead code actually was.
-->
<psalm
	errorLevel="6"
	resolveFromConfigFile="true"
	findUnusedBaselineEntry="false"
	findUnusedCode="false"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
	errorBaseline="tests/psalm-baseline.xml">
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>
	<!--
		Load the nextcloud/ocp class definitions so Psalm resolves OCP\* symbols
		(IConfig, Files\Node, AppFramework\Controller, the Settings interfaces, …).
		Without this, Psalm reports every OCP reference as UndefinedClass /
		MissingDependency / UndefinedDocblockClass. We scan only the OCP package
		(not all of vendor) to keep analysis fast. Mirrors the sibling apps.
	-->
	<extraFiles>
		<directory name="vendor/nextcloud/ocp" />
	</extraFiles>
	<!--
		Hand-written stubs for the Server-app classes that live in a real Nextcloud
		but ship in neither nextcloud/ocp nor Composer (e.g. Sabre WebDAV server
		classes, if/when a DAV guard is added). Mirrors the master (nextcloud-n8n)
		and apprentice (nextcloud-grafana) repos' psalm.xml, which stub the same
		surface the same way. Currently EMPTY — the first slice only touches OCP
		interfaces that nextcloud/ocp already provides.
	-->
	<stubs>
		<file name="tests/external-stubs.php" />
	</stubs>
	<issueHandlers>
		<!--
			These reference classes that exist at runtime in a real Nextcloud but
			are NOT shipped in nextcloud/ocp, so Psalm cannot see them: the private
			OC internals TeamFolderService reaches for when it re-inits the actor's
			filesystem so a groupfolders mount created earlier in the same request
			becomes visible (`OC_Util::tearDownFS` / `setupFS`). Not real bugs, and
			there is no public stub to import. Same handler, and same reasoning, as
			nextcloud-grafana / nextcloud-n8n.
		-->
		<UndefinedClass>
			<errorLevel type="suppress">
				<referencedClass name="OC" />
				<referencedClass name="OC_Util" />
				<referencedClass name="OC_User" />
				<!--
					`files_trashbin` is REMOVABLE, which is exactly why
					{@see OCA\PenpotSync\Service\TrashControl} resolves its manager
					lazily behind an `interface_exists()` check instead of taking it in
					the constructor — a hard dependency would make this app fail to boot
					on an instance without the trash app. Psalm cannot see the interface
					for the same reason nothing else can, so this suppression is the
					honest static counterpart of that runtime check rather than a
					silenced bug. Same entry, same reasoning, as nextcloud-grafana.
				-->
				<referencedClass name="OCA\Files_Trashbin\Trash\ITrashManager" />
				<!-- Its items, for the same reason: {@see TrashControl::listTrashed()}
					guards on `instanceof` and converts straight to this app's own
					{@see OCA\PenpotSync\Service\TrashedFile}, so the interface never
					leaves that one method. Same entry as nextcloud-n8n. -->
				<referencedClass name="OCA\Files_Trashbin\Trash\ITrashItem" />
			</errorLevel>
		</UndefinedClass>
		<!--
			MissingDependency does not support <referencedClass> in Psalm 6's
			schema, so it is suppressed wholesale. Every instance is the same
			OCP-stub artifact both siblings hit the moment they touch the
			filesystem: `OCP\Files\IRootFolder` reports its base
			`oc\hooks\emitter` as missing, because that private base ships in a
			real Nextcloud but in neither nextcloud/ocp nor Composer. It is not
			our code and there is no public stub to import — same reasoning, and
			same handler, as nextcloud-grafana / nextcloud-n8n. First needed by
			StorageService / the status command, which resolve the actor's home
			folder via IRootFolder.
		-->
		<MissingDependency errorLevel="suppress" />
	</issueHandlers>
</psalm>
