<psalm
	errorLevel="6"
	resolveFromConfigFile="true"
	findUnusedBaselineEntry="false"
	findUnusedCode="false"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
	errorBaseline="tests/psalm-baseline.xml">
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>
	<!--
		Load the nextcloud/ocp class definitions so Psalm resolves OCP\* symbols
		(IConfig, Files\Node, AppFramework\Controller, the Settings interfaces, …).
		Without this, Psalm reports every OCP reference as UndefinedClass /
		MissingDependency / UndefinedDocblockClass. We scan only the OCP package
		(not all of vendor) to keep analysis fast. Mirrors the sibling apps.
	-->
	<extraFiles>
		<directory name="vendor/nextcloud/ocp" />
	</extraFiles>
	<!--
		Hand-written stubs for the Server-app classes that live in a real Nextcloud
		but ship in neither nextcloud/ocp nor Composer (e.g. Sabre WebDAV server
		classes, if/when a DAV guard is added). Mirrors the master (nextcloud-n8n)
		and apprentice (nextcloud-grafana) repos' psalm.xml, which stub the same
		surface the same way. Currently EMPTY — the first slice only touches OCP
		interfaces that nextcloud/ocp already provides.
	-->
	<stubs>
		<file name="tests/external-stubs.php" />
	</stubs>
	<issueHandlers>
		<!--
			DELIBERATELY EMPTY FOR NOW. Both sibling repos suppress `UndefinedClass`
			for the private OC internals their repair-steps reach for (`OC`,
			`OC_Util`, `OC_User`) and suppress `MissingDependency` wholesale for an
			IRootFolder/oc\hooks\emitter stub artifact.

			This app's first slice touches none of that, and Psalm's
			`UnusedIssueHandlerSuppression` correctly FAILS the build on a
			suppression that never fires — so carrying the siblings' block here
			ahead of the code would be an error, not foresight. Re-add each
			suppression in the PR that first needs it, with the same reasoning.
		-->
	</issueHandlers>
</psalm>
