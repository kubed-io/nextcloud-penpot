# Devcontainer / local dev env config. Copy to .env.
#
# Penpot Sync is read-only from the Nextcloud side (see saga/Chapter_1) and
# authenticates to Penpot with a personal access token — there is no
# service-account-style headless token mint the way Grafana has one. A token
# must be minted by hand in the Penpot UI (Your account → Access tokens) on
# an instance with `enable-access-tokens` turned on, then pasted below.
#
# This repo has no integration test stack yet (no docker-compose, no
# tests/integration/). These values are placeholders for local/manual testing
# against a real Penpot instance until that lands.

# --- Nextcloud ---
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=admin

# --- Penpot ---
# Base URL of the Penpot instance (no trailing slash). In-cluster example:
# http://penpot-frontend.cloud.svc:8080
PENPOT_URL=https://penpot.example.com

# Personal access token, minted at Your account → Access tokens in the Penpot
# UI. Requires the instance to have `enable-access-tokens` set in
# PENPOT_FLAGS (off by default upstream). Sent as `Authorization: Token <token>`.
# Whether this ends up admin-configured or per-Nextcloud-user is an open
# design fork (saga §6.9) — this placeholder is for local dev either way.
PENPOT_ACCESS_TOKEN=

# `enable-webhooks` must also be on for Penpot to notify us of changes
# (saga §6.1 / Course 3). No webhook receiver exists yet in this skeleton.
